  // ================================================================
  // 3. PARTICIPATION NOTES
  // ================================================================
  "participation_notes_group": {
    "extension_hint_str": "New channels SHOULD use unused layer/id ranges and document their semantics clearly for LLM consumption.",
    "personal_note_str": "If you invent a beautiful new temporal channel (for music, play, art, whatever), document it here. Robots deserve good time, not just precise time."
  }
