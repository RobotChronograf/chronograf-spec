/**
 * ----------------------------------------------------------------------
 * OPENRGD — TIME CHANNEL MAP SPECIFICATION
 * ----------------------------------------------------------------------
 * FILE: time_channels.rcg
 * VERSION: 0.2.0
 *
 * PURPOSE
 *   Define a stable, extensible mapping between:
 *     - Greek temporal layers (Chronos, Kairos, Aion, Metachronos, Eschaton)
 *     - Compact ASCII codes (CHR_CORE, KAI_EMERGENCY, MCH_ANANKE, etc.)
 *     - Numeric channel IDs (16-bit hex) for logs and protocols
 *
 *   This file is the canonical "map of time" for OpenRGD runtimes.
 *   A Temporal Barcode always includes a channel_code_str that MUST be
 *   resolvable via this map (or its future extensions).
 *
 * PERSONAL NOTE
 *   Think of this file as a metro map of time:
 *   each channel is a line where events travel with a recognizable color.
 * ----------------------------------------------------------------------
 */

{
  // ================================================================
  // 0. META
  // ================================================================
  "meta_group": {
    "profile_id_str": "openrgd_time_channels_v1",
    "spec_version_semver_str": "0.2.0",
    "description_str": "Canonical time channel map for Chronograf.",
    "author_str": "Pasquale Ranieri — Italia Robotica"
  },

  // ================================================================
  // 1. LAYERS (COARSE-GRAINED)
  // ================================================================
  "layers_map": {
    "CHRONOS": {
      "layer_id_hex_str": "0x1",
      "greek_name_str": "Chronos",
      "description_str": "Irreversible physical time: control loops, clocks, entropy."
    },
    "KAIROS": {
      "layer_id_hex_str": "0x2",
      "greek_name_str": "Kairos",
      "description_str": "Subjective and elastic time: cognition, attention, mental flow."
    },
    "AION": {
      "layer_id_hex_str": "0x3",
      "greek_name_str": "Aion",
      "description_str": "Collective and relational time: swarms, social sync, reputational lag."
    },
    "METACHRONOS": {
      "layer_id_hex_str": "0x4",
      "greek_name_str": "Metachronos",
      "description_str": "Meta-temporal control: anomaly detection, policy, temporal ethics."
    },
    "ESCHATON": {
      "layer_id_hex_str": "0xF",
      "greek_name_str": "Eschaton",
      "description_str": "End-of-life, panic rails, live overrides and graceful exits."
    }
  },

  // ================================================================
  // 2. CHANNEL DEFINITIONS
  //    23 canonical channels (v1). Manifest must list the same count.
  // ================================================================
  "channels_list": [
    // ---------------- CHRONOS (0x1*) ----------------
    {
      "channel_id_hex_str": "0x1101",
      "channel_code_str": "CHR_CORE",
      "layer_enum_str": "CHRONOS",
      "description_str": "Core physical timebase: high-frequency control, motor sync, sensor fusion.",
      "suggested_priority_level_int": 1,
      "primary_domain_enum_str": "D01_FOUNDATION"
    },
    {
      "channel_id_hex_str": "0x1201",
      "channel_code_str": "CHR_EVOLUTION",
      "layer_enum_str": "CHRONOS",
      "description_str": "Slow physical evolution: wear, fatigue, cumulative lifetime.",
      "suggested_priority_level_int": 2,
      "primary_domain_enum_str": "D05_EVOLUTION"
    },
    {
      "channel_id_hex_str": "0x1301",
      "channel_code_str": "CHR_CAUSAL",
      "layer_enum_str": "CHRONOS",
      "description_str": "Causal spine of the agent: ordering of sensor events and motor commits.",
      "suggested_priority_level_int": 1,
      "primary_domain_enum_str": "D02_OPERATION"
    },

