/**
 * ----------------------------------------------------------------------
 * OPENRGD — CHRONOGRAF MANIFEST
 * ----------------------------------------------------------------------
 * FILE: chronograf_manifest.rcg
 * VERSION: 0.2.0 (Chronograf Draft)
 *
 * PURPOSE:
 *   Precomputed manifest for the Chronograf subsystem.
 *
 *   This file is intended to:
 *   - avoid expensive parsing and recomputation during runtime,
 *   - provide a single integrity checkpoint for all time *.rcg files,
 *   - give the Time Kernel a compact, cache-friendly summary of
 *     loops, channels, priorities and temporal contracts,
 *   - expose a stable view of the "Temporal Barcode" contract for LLMs.
 *
 * GENERATED BY:
 *   A build-time tool (e.g. `openrgd chronograf build`) that:
 *   - parses time_kernel.rcg, time_channels.rcg, time_topology.rcg
 *   - validates internal consistency
 *   - emits this manifest as a frozen snapshot.
 *
 * RUNTIME CONTRACT:
 *   - The kernel SHOULD load this manifest once at boot.
 *   - The kernel MUST verify the source hashes before trusting it.
 *   - The kernel MUST NOT recompute expensive graph traversals
 *     on every tick; it SHOULD rely on these precomputed views.
 *
 * PERSONAL NOTE:
 *   Think of this as the "boarding pass" for time:
 *   if this manifest is clean, the agent may safely board Chronos.
 * ----------------------------------------------------------------------
 */

{
  // ================================================================
  // 0. META
  // ================================================================
  "meta_group": {
    "manifest_id_str": "chronograf_manifest_v2",
    "spec_version_semver_str": "0.2.0",
    "generated_by_str": "openrgd_tools/chronograf_builder_v2",
    // MUST be set by the build tool, e.g. UTC now.
    "generated_at_iso8601_str": "__TO_BE_SET_AT_BUILD_TIME__",
    "description_str": "Compact, integrity-checked summary of the temporal configuration, Time Atom contract and Temporal Barcode layout for this agent.",
    "author_str": "Pasquale Ranieri — Italia Robotica"
  },

  // ================================================================
  // 1. SOURCE FILE INTEGRITY
  //    If any hash changes, the Chronograf is considered tampered.
  // ================================================================
  "sources_group": {
    "time_kernel_file": {
      "relative_path_str": "time_kernel.rcg",
      // MUST be populated by the Chronograf build tool.
      // If this value is still "__TO_BE_FILLED_BY_BUILD_TOOL__", the
      // kernel MUST treat this manifest as INVALID.
      "expected_sha256_hex_str": "__TO_BE_FILLED_BY_BUILD_TOOL__"
    },
    "time_channels_file": {
      "relative_path_str": "time_channels.rcg",
      "expected_sha256_hex_str": "__TO_BE_FILLED_BY_BUILD_TOOL__"
    },
    "time_topology_file": {
      "relative_path_str": "time_topology.rcg",
      "expected_sha256_hex_str": "__TO_BE_FILLED_BY_BUILD_TOOL__"
    }
  },

  // ================================================================
  // 2. GLOBAL TEMPORAL BOUNDS
  //    Used for quick sanity checks and scheduler guardrails.
  //    These SHOULD be auto-computed by the build tool.
  // ================================================================
  "bounds_group": {
    "max_loop_frequency_hz_float": 1000.0,
    // Highest frequency among all defined loops (e.g. Chronos core).

    "min_loop_frequency_hz_float": 1.0,
    // Lowest frequency among active loops (e.g. oneiric / maintenance).

    "max_allowed_jitter_ms_float": 0.5,
    // Derived from time_kernel; used as a global “red line” for temporal anomalies.

    "total_defined_channels_int": 23,
    // MUST match channels_list length in time_channels.rcg.

    "total_defined_loops_int": 4
    // MUST match loops_list length in time_topology.rcg.
  },

  // ================================================================
  // 2.b RUNTIME TIME CONTRACT
  //     Quick-access view of Time Atom & timescales for this agent.
  // ================================================================
  "runtime_time_contract_group": {
    "time_atom_version_str": "time_atom_v1",
    // MUST match time_kernel.time_atom_encoding_group.version_str.

    "epoch_reference_enum_str": "TAI",
    // MUST match time_kernel.time_atom_encoding_group.epoch_reference_enum_str.

    "min_supported_tick_exp10_int": -18,
    // Theoretical floor (10^-18 seconds, attoseconds).

    "nominal_runtime_precision_exp10_int": -9,
    // Target runtime precision for this agent (10^-9 seconds, nanoseconds).

    "supported_timescales_arr": [
      "UTC",
      "TAI",
      "GPS",
      "LOCAL_MONOTONIC",
      "SIM_TIME"
    ],

    "default_display_timescale_enum_str": "UTC",
    // Recommended timescale for human-facing tools (CLI, dashboards).

    "default_cli_output_format_enum_str": "ISO8601_UTC_PLUS_ATOM",
    // Recommended format for tools like `rgd-now`.
    
    "doc_str": "This group summarizes how the Time Atom is instantiated in this profile so that kernels and tools do not need to re-parse the entire kernel file."
  },

  // ================================================================
  // 2.c UNCERTAINTY CONTRACT
  //     How uncertainty should be exposed in events and logs.
  // ================================================================
  "uncertainty_contract_group": {
    "uses_parametric_uncertainty_bool": true,
    // If true, events SHOULD carry uncertainty as (value, exp10, semantic_kind).

    "default_uncertainty_exp10_int": -6,
    // Default runtime uncertainty scale (e.g. 10^-6 = microseconds) if not otherwise measured.

    "max_uncertainty_exp10_int": 0,
    // Upper bound (10^0 = 1 second) beyond which events MAY be considered temporally unreliable.

    "supported_semantic_kinds_list": [
      "TIME_SOURCE",
      "TRANSMISSION",
      "QUANTIZATION",
      "COMPUTE_LOAD",
      "SIMULATION_SCALING",
      "SEMANTIC_DRIFT"
    ],

    "llm_friendly_schema_hint_str": "time_atom_obj.uncertainty_group",
    // Hint for tools / LLMs on where to find uncertainty in standard JSON payloads.

    "doc_str": "Uncertainty is not an afterthought: it is a first-class dimension of every Temporal Barcode."
  },

  // ================================================================
  // 3. TEMPORAL BARCODE CONTRACT
  //    How events are encoded for logs & LLM consumption.
  // ================================================================
  "temporal_barcode_contract_group": {
    "temporal_barcode_version_str": "temporal_barcode_v1",
    // MUST match time_kernel.temporal_barcode_schema_group.version_str.

    "required_fields_list": [
      "time_atom_obj",
      "channel_code_str",
      "loop_id_str",
      "primary_domain_enum_str",
      "event_kind_enum_str"
    ],
    "recommended_fields_list": [
      "uncertainty_group",
      "source_agent_id_str",
      "target_agent_id_str",
      "context_span_id_str",
      "payload_ref_str"
    ],

    "max_barcode_rate_hz_float": 10000.0,
    // Upper bound for event logging rate (for back-pressure / QoS).

    "llm_streaming_hint_str": "Temporal Barcodes SHOULD be emitted as newline-delimited JSON objects for efficient LLM streaming.",

    "schema_layout_doc_str": "A Temporal Barcode is a compact JSON fragment: {time_atom_obj, channel_code_str, loop_id_str, primary_domain_enum_str, event_kind_enum_str, uncertainty_group?, context_span_id_str?, payload_ref_str?}."
  },

  // ================================================================
  // 4. PRECOMPUTED LOOP SCHEDULE
  //    A flattened, cache-friendly view of loops in execution order.
  // ================================================================
  "loop_schedule_group": {
    // Loops ordered by priority and frequency, already resolved.
    "ordered_loops_list": [
      {
        "loop_id_str": "loop_chronos_core",
        "driven_by_channel_code_str": "CHR_CORE",
        "target_frequency_hz_float": 1000.0,
        "priority_enum_str": "HIGHEST",
        "updates_domains_list": ["D01_FOUNDATION", "D02_OPERATION"],
        "description_str": "High-frequency body loop: motors, low-level sensors, immediate safety."
      },
      {
        "loop_id_str": "loop_kairos_cognition",
        "driven_by_channel_code_str": "KAI_BASE",
        "target_frequency_hz_float": 10.0,
        "priority_enum_str": "HIGH",
        "updates_domains_list": ["D03_AGENCY", "D04_VOLITION"],
        "description_str": "Cognitive loop: perception, appraisal, planning, medium-term decisions."
      },
      {
        "loop_id_str": "loop_aion_social",
        "driven_by_channel_code_str": "AIO_SWARM",
        "target_frequency_hz_float": 2.0,
        "priority_enum_str": "MEDIUM",
        "updates_domains_list": ["D06_ETHER"],
        "description_str": "Social/swarm loop: multi-agent coordination, consensus, social timing."
      },
      {
        "loop_id_str": "loop_kairos_oneiric",
        "driven_by_channel_code_str": "KAI_ONEIRIC",
        "target_frequency_hz_float": 1.0,
        "priority_enum_str": "LOW",
        "updates_domains_list": ["D03_AGENCY", "D05_EVOLUTION"],
        "description_str": "Oneiric loop: replay, consolidation, dreams and self-model updates."
      }
    ],

    // Direct adjacency list for “who feeds whom”, already resolved.
    "loop_dependencies_adj_list": [
      {
        "upstream_loop_id_str": "loop_chronos_core",
        "downstream_loop_ids_list": ["loop_kairos_cognition", "loop_kairos_oneiric"],
        "description_str": "Physical body loop feeds both live cognition and oneiric consolidation."
      },
      {
        "upstream_loop_id_str": "loop_kairos_cognition",
        "downstream_loop_ids_list": ["loop_aion_social"],
        "description_str": "Cognitive decisions propagate into social/swarm coordination."
      }
    ]
  },

  // ================================================================
  // 5. PRECOMPUTED CHANNEL PRIORITIES
  //    For logging, QoS and selective sampling.
  // ================================================================
  "channels_priority_group": {
    // Sorted by priority_level_int (1 = highest).
    "priority_buckets_list": [
      {
        "priority_level_int": 1,
        "channel_codes_list": [
          "CHR_CORE",
          "CHR_CAUSAL",
          "KAI_EMERGENCY",
          "ESC_PAN_REQUEST",
          "ESC_LIVE",
          "ESC_POLICY",
          "ESC_GRACE"
        ]
      },
      {
        "priority_level_int": 2,
        "channel_codes_list": [
          "CHR_EVOLUTION",
          "KAI_BASE",
          "KAI_PREDICT",
          "AIO_SWARM",
          "AIO_MAINT_WINDOW",
          "MCH_SYMPATHEIA"
        ]
      },
      {
        "priority_level_int": 3,
        "channel_codes_list": [
          "AIO_INTERACTION",
          "MCH_ANANKE",
          "MCH_ALETHEIA",
          "MCH_ENARGEIA",
          "MCH_PHYSIS",
          "MCH_HYPOSTASIS"
        ]
      },
      {
        "priority_level_int": 4,
        "channel_codes_list": [
          "KAI_IDLE",
          "KAI_ONEIRIC",
          "AIO_RHYTHM_SYS",
          "MCH_PALINGENESIA"
        ]
      }
    ]
  },

  // ================================================================
  // 6. FAST LOOKUP TABLES
  //    Pre-flattened maps for hot paths (no string walking).
  // ================================================================
  "fast_lookup_group": {
    // Channel → primary domain binding (single-hop lookup).
    "channel_primary_domain_map": {
      "CHR_CORE":        "D01_FOUNDATION",
      "CHR_CAUSAL":      "D02_OPERATION",
      "CHR_EVOLUTION":   "D05_EVOLUTION",

      "KAI_BASE":        "D03_AGENCY",
      "KAI_PREDICT":     "D03_AGENCY",
      "KAI_ONEIRIC":     "D03_AGENCY",
      "KAI_EMERGENCY":   "D03_AGENCY",
      "KAI_IDLE":        "D03_AGENCY",

      "AIO_SWARM":       "D06_ETHER",
      "AIO_INTERACTION": "D06_ETHER",
      "AIO_RHYTHM_SYS":  "D06_ETHER",
      "AIO_MAINT_WINDOW":"D06_ETHER",

      // Cross-cutting / meta-temporal channels:
      "MCH_ANANKE":      "META_CROSS",
      "MCH_ALETHEIA":    "META_CROSS",
      "MCH_SYMPATHEIA":  "META_CROSS",
      "MCH_ENARGEIA":    "META_CROSS",
      "MCH_PHYSIS":      "META_CROSS",
      "MCH_HYPOSTASIS":  "META_CROSS",
      "MCH_PALINGENESIA":"META_CROSS",
      "ESC_PAN_REQUEST": "META_CROSS",
      "ESC_LIVE":        "META_CROSS",
      "ESC_POLICY":      "META_CROSS",
      "ESC_GRACE":       "META_CROSS",

      // Fallback for unknown or future channels.
      "DEFAULT":         "META_CROSS"
    },

    // Direct access for channel ID (hex) → code_str, to skip opening time_channels.rcg.
    "channel_id_to_code_map": {
      "0x1101": "CHR_CORE",
      "0x1201": "CHR_EVOLUTION",
      "0x1301": "CHR_CAUSAL",

      "0x2101": "KAI_BASE",
      "0x2102": "KAI_EMERGENCY",
      "0x2103": "KAI_IDLE",
      "0x2201": "KAI_PREDICT",
      "0x2301": "KAI_ONEIRIC",

      "0x3101": "AIO_INTERACTION",
      "0x3201": "AIO_SWARM",
      "0x3301": "AIO_RHYTHM_SYS",
      "0x3302": "AIO_MAINT_WINDOW",

      "0x4101": "MCH_ANANKE",
      "0x4201": "MCH_ALETHEIA",
      "0x4301": "MCH_SYMPATHEIA",
      "0x4401": "MCH_ENARGEIA",
      "0x4501": "MCH_PHYSIS",
      "0x4601": "MCH_HYPOSTASIS",
      "0x4701": "MCH_PALINGENESIA",

      "0xF000": "ESC_PAN_REQUEST",
      "0xF101": "ESC_LIVE",
      "0xF102": "ESC_POLICY",
      "0xF103": "ESC_GRACE"
    }
  },

  // ================================================================
  // 7. SEMANTIC VOCABULARY (RFC 5545 ADAPTATION)
  //    Controlled vocabulary for Aion Rhythms to ensure safe parsing.
  // ================================================================
  "semantic_vocabulary_group": {
    "supported_frequencies_list": [
      "SECONDLY",
      "MINUTELY",
      "HOURLY",
      "DAILY",
      "WEEKLY",
      "MONTHLY",
      "YEARLY"
    ],
    // Whitelisted operators the Kernel guarantees to support.
    "supported_operators_list": [
      "BYDAY",
      "BYMONTH",
      "BYHOUR",
      "BYMINUTE",
      "INTERVAL",
      "COUNT",
      "UNTIL"
    ],
    // Standard aliases for common robotic rhythms.
    "predefined_rhythms_map": {
      "STD_BUSINESS_HOURS": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=9,10,11,12,13,14,15,16,17",
      "STD_WEEKEND_OFF":    "FREQ=WEEKLY;BYDAY=SA,SU",
      "STD_NIGHT_SHIFT":    "FREQ=DAILY;BYHOUR=22,23,0,1,2,3,4,5,6",
      "STD_WEEKLY_MAINT":   "FREQ=WEEKLY;BYDAY=SU;BYHOUR=03;BYMINUTE=00"
    }
  },

  // ================================================================
  // 8. RUNTIME HINTS
  //    How the kernel SHOULD treat the Chronograf at runtime.
  // ================================================================
  "runtime_hints_group": {
    "should_cache_entire_manifest_in_ram_bool": true,
    // The kernel is expected to keep this manifest fully in memory.

    "should_avoid_reopening_source_files_bool": true,
    // Once hashes are validated at boot, the kernel SHOULD NOT re-open
    // time_kernel.rcg / time_channels.rcg / time_topology.rcg in hot paths.

    "max_recompute_rate_hz_float": 0.1,
    // Heavy recomputations (e.g. rebuilding graphs) SHOULD NOT
    // happen more than 0.1 Hz (~ every 10 seconds) and only in maintenance mode.

    "llm_observability_hint_str": "If logs expose Temporal Barcodes plus channel_code_str and loop_id_str, most LLMs can reconstruct high-level behavior without additional schema.",
    "personal_note_str": "If you are debugging this at 3AM: breathe. Time is weird, but this manifest is on your side."
  }
}
